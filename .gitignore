# =========================================================
# FYP Medical AI Chatbot & Report Analyzer - Root Gitignore
# Covers: ai-backend (FastAPI), server (Express), client (React)
# =========================================================

# --- Python Environments & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
*.egg

# --- Node.js & Frontend Build Outputs ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
client/dist/
client/dist-ssr/
out/
.next/

# --- Environment Configurations & Secrets ---
.env
.env.*
!.env.example
!.env.sample

# --- OS & IDE Clutter ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Testing, Coverage & Quality Tooling ---
.pytest_cache/
ai-backend/.pytest_cache/
coverage/
.coverage
htmlcov/

# --- Private Uploads, Vectors & Runtime Caches ---
uploads/
ai-backend/uploads/
chroma_db/
ai-backend/chroma_db/
private-reports/
scratch/
.test-runtime/

# Local Ollama model binaries
.ollama-models/
