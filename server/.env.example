# Copy to .env, which is ignored. Enter your own URI privately.
# Use Atlas, or an initiated local replica set. Standalone MongoDB is unsupported.
MONGODB_URI=mongodb://127.0.0.1:27017/fyp_auth?replicaSet=rs0
# Replace with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=5000
# Optional: defaults to server/private-reports; keep outside all public directories.
# REPORT_STORAGE_DIR=F:/private-fyp-reports
REPORT_MAX_BYTES=10485760
REPORT_MAX_COUNT=20
REPORT_MAX_TOTAL_BYTES=104857600
REPORT_MAX_PIXELS=20000000
# Review demo uses only a dedicated server-generated synthetic sample.
EXTRACTION_DEMO_ENABLED=false
# off or fastapi. Production rejects enabling the synthetic demo.
EXTRACTION_PROVIDER=off
CHAT_PROVIDER=demo
EXTRACTION_TIMEOUT_MS=45000
# Only when enabling the supplied FastAPI adapter; set its key privately.
# AI_SERVICE_URL=http://127.0.0.1:8000
# AI_INTERNAL_KEY=REPLACE_WITH_PRIVATE_SERVICE_KEY
# Leave unset locally. For a verified loopback HTTPS reverse proxy only:
# TRUST_PROXY=loopback
