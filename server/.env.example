# Copy to .env, which is ignored. Enter your own URI privately.
MONGODB_URI=mongodb://127.0.0.1:27017/fyp_auth
# Replace with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=5000
# Leave unset locally. For a verified loopback HTTPS reverse proxy only:
# TRUST_PROXY=loopback
