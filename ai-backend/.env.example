PROJECT_NAME="Medical AI Backend"
VERSION="1.0.0"
DEBUG=true

# Security Key for Internal API Communication (FastAPI <-> Express/React)
INTERNAL_API_KEY="medical-ai-internal-key-2026"

# Ollama LLM Service Configuration
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_MODEL="llama3.2:3b"
EMBEDDING_MODEL="nomic-embed-text"
MODEL_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE="60m"
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=4
